{
  "version": 2,
  "source": "проверено носителем — партия 1 (диалоги 1–6). v2: he очищены от пометок, пометки в note.",
  "dialogue_daily": false,
  "week_cycle": true,
  "dialogues": [
    {
      "id": "d01",
      "category": "знакомство",
      "title_ru": "Приветствие",
      "title_he": "ברכה",
      "lines": [
        {
          "who": "a",
          "ru": "Привет! Как дела?",
          "variants": [
            { "he": "שלום! מה נשמע?" }
          ]
        },
        {
          "who": "b",
          "ru": "Привет! Всё в порядке, спасибо. А у тебя?",
          "variants": [
            { "he": "שלום! הכול בסדר, תודה. ואת?", "note": "обращение к женщине" },
            { "he": "שלום! הכול בסדר, תודה. ואתה?", "note": "обращение к мужчине" }
          ]
        },
        {
          "who": "a",
          "ru": "Тоже хорошо. Иду в магазин. Хорошего дня!",
          "variants": [
            { "he": "גם אני בסדר. הולך לסופר. שיהיה לך יום טוב!", "note": "говорит мужчина" },
            { "he": "גם אני בסדר. הולכת לסופר. שיהיה לך יום טוב!", "note": "говорит женщина" }
          ]
        },
        {
          "who": "b",
          "ru": "А я уже сходил в магазин. И тебе! До завтра.",
          "variants": [
            { "he": "אני כבר הייתי בסופר. וגם לך! להתראות מחר." }
          ]
        }
      ]
    },
    {
      "id": "d02",
      "category": "знакомство",
      "title_ru": "Представление",
      "title_he": "היכרות",
      "lines": [
        {
          "who": "a",
          "ru": "Доброе утро! Меня зовут Ольга. А тебя?",
          "variants": [
            { "he": "בוקר טוב! קוראים לי אולגה. ואת?", "note": "обращение к женщине" },
            { "he": "בוקר טוב! קוראים לי אולגה. ואתה?", "note": "обращение к мужчине" },
            { "he": "בוקר טוב! קוראים לי אולגה. ולך?", "note": "альтернатива от носителя" }
          ]
        },
        {
          "who": "b",
          "ru": "Меня зовут Давид. Как ты?",
          "variants": [
            { "he": "קוראים לי דוד. מה שלומך?", "note": "обращение к женщине" },
            { "he": "קוראים לי דוד. מה שלומך?", "note": "обращение к мужчине (на письме так же)" }
          ]
        },
        {
          "who": "a",
          "ru": "Приятно познакомиться. У меня всё хорошо.",
          "variants": [
            { "he": "נעים מאוד. הכול בסדר אצלי." }
          ]
        },
        {
          "who": "b",
          "ru": "Мне тоже очень приятно. Хорошего вечера.",
          "variants": [
            { "he": "נעים מאוד גם לי. שיהיה ערב טוב." }
          ]
        }
      ]
    },
    {
      "id": "d03",
      "category": "знакомство",
      "title_ru": "Откуда ты",
      "title_he": "מאיפה אתה?",
      "lines": [
        {
          "who": "a",
          "ru": "Добрый день. Откуда ты?",
          "variants": [
            { "he": "אחר הצהריים טובים. מאיפה את?", "note": "обращение к женщине" },
            { "he": "אחר הצהריים טובים. מאיפה אתה?", "note": "обращение к мужчине" }
          ]
        },
        {
          "who": "b",
          "ru": "Я из России. Из Москвы. А ты?",
          "variants": [
            { "he": "אני מרוסיה. ממוסקבה. ואת?", "note": "обращение к женщине" },
            { "he": "אני מרוסיה. ממוסקבה. ואתה?", "note": "обращение к мужчине" }
          ]
        },
        {
          "who": "a",
          "ru": "Я из Израиля. Из Холона. Я пошёл на море.",
          "variants": [
            { "he": "אני מישראל. מחולון. הולך לים.", "note": "говорит мужчина" },
            { "he": "אני מישראל. מחולון. הולכת לים.", "note": "говорит женщина" }
          ]
        }
      ]
    },
    {
      "id": "d04",
      "category": "знакомство",
      "title_ru": "Время",
      "title_he": "מה השעה?",
      "lines": [
        {
          "who": "a",
          "ru": "Подскажите, который час?",
          "variants": [
            { "he": "סליחה, מה השעה?" }
          ]
        },
        {
          "who": "b",
          "ru": "Семь пятьдесят. Аптека скоро откроется.",
          "variants": [
            { "he": "שבע וחמישים. בית המרקחת ייפתח בקרוב." }
          ]
        },
        {
          "who": "a",
          "ru": "Большое спасибо. Мне срочно надо купить лекарство.",
          "variants": [
            { "he": "תודה רבה. אני חייבת לקנות תרופה בדחיפות.", "note": "говорит женщина" },
            { "he": "תודה רבה. אני חייב לקנות תרופה בדחיפות.", "note": "говорит мужчина" }
          ]
        }
      ]
    },
    {
      "id": "d05",
      "category": "знакомство",
      "title_ru": "Я новенькая",
      "title_he": "אני חדשה",
      "lines": [
        {
          "who": "a",
          "ru": "Всем привет. Я тут новенькая, недавно приехала.",
          "variants": [
            { "he": "שלום לכולם. אני חדשה כאן, הגעתי לאחרונה." }
          ]
        },
        {
          "who": "b",
          "ru": "Добро пожаловать! Откуда приехала?",
          "variants": [
            { "he": "ברוכה הבאה! מאיפה הגעת?" }
          ]
        },
        {
          "who": "a",
          "ru": "Из Беларуси. Из Гродно.",
          "variants": [
            { "he": "מבלארוס. מגרודנו." }
          ]
        },
        {
          "who": "b",
          "ru": "И как тебе тут?",
          "variants": [
            { "he": "נחמד לך פה?", "note": "тебе тут нравится?" },
            { "he": "את מסתדרת פה?", "note": "ты тут справляешься?" }
          ]
        }
      ]
    },
    {
      "id": "d06",
      "category": "знакомство",
      "title_ru": "Прощание",
      "title_he": "להתראות",
      "lines": [
        {
          "who": "a",
          "ru": "Простите! Это не ваше?",
          "variants": [
            { "he": "סליחה! זה לא שלכם?" }
          ]
        },
        {
          "who": "b",
          "ru": "Нет. Это не я оставил. Чьё это?",
          "variants": [
            { "he": "לא. אני לא השארתי את זה. של מי זה?" }
          ]
        },
        {
          "who": "a",
          "ru": "Я тоже не знаю.",
          "variants": [
            { "he": "גם אני לא יודעת.", "note": "говорит женщина" },
            { "he": "גם אני לא יודע.", "note": "говорит мужчина" }
          ]
        }
      ]
    }
  ]
}
